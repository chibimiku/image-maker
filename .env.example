# 本地密钥文件模板：复制成 .env 后填写真实值（.env 已被 .gitignore 忽略，不会入库）
#
# 变量名规则：IMAGE_MAKER_<节点名>_API_KEY（节点名里的 - / . 换成 _）
# 节点里写了 env_slug 的，用 slug 作变量名，同一家服务的多个节点共用一把。
# 优先级：真实环境变量 > .env > conf/config.json

# new.aigc2d.com（apis.aigc2d 与 apis.aigc-2d-gpt 共用）
IMAGE_MAKER_AIGC2D_API_KEY=

# 其他站点（按需填写）
# IMAGE_MAKER_AUTODL_API_KEY=
# IMAGE_MAKER_WHATUP_API_KEY=
# IMAGE_MAKER_OPENROUTER_IMAGE_API_KEY=
