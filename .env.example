# 本地密钥文件模板：复制成 .env 后填写真实值（.env 已被 .gitignore 忽略，不会入库）
#
# 变量名规则：IMAGE_MAKER_<节点名>_API_KEY（节点名里的 - / . 换成 _）
# 节点里写了 env_slug 的，用 slug 作变量名，同一家服务的多个节点共用一把。
# 优先级：真实环境变量 > .env > conf/config.json
#
# 为什么用 .env 而不是 setx：setx 设的用户环境变量对「在它之前启动的进程」无效
# （常驻 GUI / 编辑器 / 老终端内存里的环境块是旧的，spawn 出来的子进程也拿不到）。
# .env 由 utils/env_loader.py 在 api_backend 导入时读取，怎么启动都能生效。

# ============ 图片 API 节点（conf/config.json 的 apis.*） ============
# new.aigc2d.com（apis.aigc2d 与 apis.aigc-2d-gpt 共用）
IMAGE_MAKER_AIGC2D_API_KEY=

# 其他站点（按需填写）
# IMAGE_MAKER_AUTODL_API_KEY=
# IMAGE_MAKER_WHATUP_API_KEY=
# IMAGE_MAKER_OPENROUTER_IMAGE_API_KEY=

# ============ 顶层文本 API（conf/config.json 顶层键） ============
# 「文本分析 API」：base_url / api_key / model。
# 图片分析 Step 1、画风压缩、booru tag 翻译、SD 工作流的 LLM 步骤都走这一把。
IMAGE_MAKER_TEXT_API_KEY=

# 「NSFW 文本 API」：nsfw_base_url / nsfw_api_key / nsfw_model。
# 批量分析的 NSFW 通道、pixiv 标签筛选/校验脚本走这一把。
IMAGE_MAKER_NSFW_API_KEY=
# ── （可选）把「图片 API 节点」也写在这里，conf/config.json 里就不必存 base_url ──
# 写法一：整体 JSON（节点名 -> 定义）
# IMAGE_MAKER_NODES={"whatup": {"base_url": "https://api.whatai.cc/v1", "model": "nano-banana-2", "env_slug": "aigc2d"}}
# 写法二：逐节点
# IMAGE_MAKER_WHATUP_BASE_URL=https://api.whatai.cc/v1
# IMAGE_MAKER_WHATUP_MODEL=nano-banana-2
# IMAGE_MAKER_WHATUP_ENV_SLUG=aigc2d      # 复用 IMAGE_MAKER_AIGC2D_API_KEY 这把钥匙
# IMAGE_MAKER_WHATUP_API_KEY=sk-...       # 或者直接给该节点自己的钥匙
