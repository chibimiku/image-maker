{
    "_comment": "gpt-image 产物优化（Gemini 重绘提线）统一配置。改这里即可换 prompt / 站点 / 模型 / 尺寸，不要在 .py 里写死。",
    "_theory": "理论、实验数据与指标口径见 docs/gpt-image-optimize/README.md。",
    "enabled": false,
    "site": "new.aigc2d",
    "api_type": "aigc2d",
    "model": "gemini-3-pro-image-preview",
    "resolution": "2K",
    "_aspect_comment": "auto = 不传 aspectRatio，由模型按输入图比例输出（官方默认行为）；换任意源图都不会被拉伸或裁切。要强制比例再选具体值。",
    "aspect_ratio": "auto",
    "aspect_ratio_options": [
        "auto",
        "1:1",
        "3:2",
        "2:3",
        "3:4",
        "4:3",
        "4:5",
        "5:4",
        "9:16",
        "16:9",
        "21:9"
    ],
    "repeat": 1,
    "save_sub_dir": "gpt_image_repaint",
    "file_prefix": "repaint",
    "system_prompt": "gpt-image-optimize/repaint-system.md",
    "detail_suffix": "gpt-image-optimize/repaint-detail-suffix.md",
    "use_detail_suffix": true,
    "model_options": [
        "gemini-3-pro-image-preview",
        "gemini-3-pro-image",
        "gemini-3.1-flash-image-preview",
        "gemini-3.1-flash-image"
    ],
    "resolution_options": [
        "1K",
        "2K",
        "4K"
    ]
}